# ─────────────────────────────────────────────────────────
# Zoe Essence — Environment Variables
# Copy this file to .env for local development.
# In Vercel: add these in Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...   # anon/public key

# Also expose to the client (Vite build-time replacement)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...   # same anon/public key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Service role key — server-side only, NEVER expose to browser
# Found in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Resend email (required for order + password-reset emails) ──
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_...
